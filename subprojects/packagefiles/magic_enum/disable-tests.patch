From 5a136ba12f1a4f4c048093d19f957fe5b55ce8ac Mon Sep 17 00:00:00 2001
From: Frankie Robertson <frankie@robertson.name>
Date: Thu, 2 Oct 2025 13:18:41 +0300
Subject: [PATCH] Replace test option with not building tests by default

---
 meson.build       | 4 +---
 meson_options.txt | 7 -------
 test/meson.build  | 1 +
 3 files changed, 2 insertions(+), 10 deletions(-)

diff --git a/meson.build b/meson.build
index 679781da50..69c901d36d 100644
--- a/meson.build
+++ b/meson.build
@@ -27,6 +27,4 @@ pkg.generate(
   extra_cflags: magic_enum_args,
 )

-if get_option('test')
-    subdir('test')
-endif
+subdir('test')
diff --git a/meson_options.txt b/meson_options.txt
index 482f89f1d0..a043f3ca15 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,10 +1,3 @@
-option(
-    'test',
-    type : 'boolean',
-    value : true,
-    description : 'Build and run tests'
-)
-
 option(
     'hash',
     type : 'boolean',
diff --git a/test/meson.build b/test/meson.build
index 8e34b3ff4b..3ee7692a47 100644
--- a/test/meson.build
+++ b/test/meson.build
@@ -10,6 +10,7 @@ foreach test_name, test_src : test_files
         test_name.underscorify(),
         test_src,

+        build_by_default: false,
         dependencies: [magic_enum_dep, catch2_dep],
     )
